# Copia este archivo a ".env.local" y reinicia "npm run dev".
# URL base del API Gateway SIN diagonal final.
#
# LocalStack: el id cambia cada vez que se vuelve a crear el Gateway.
# Búscalo en la salida de "npm run deploy" de Taller_Gateway (endpoint: .../restapis/<ID>/local/...)
NEXT_PUBLIC_API_URL=http://localhost:4566/restapis/TU_API_ID/local/_user_request_
